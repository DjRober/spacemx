# nginx para la imagen all-in-one (Render). Todos los servicios corren en
# ESTE contenedor, por eso el proxy va a 127.0.0.1:300X (no a nombres de red).
# El puerto de escucha lo inyecta Render por $PORT (lo resuelve entrypoint.sh
# con envsubst antes de arrancar).

server {
    listen ${PORT};
    server_name _;

    root /app/public;
    index index.html;

    # /api/* → cada microservicio local (mismo contenedor)
    location /api/apod        { proxy_pass http://127.0.0.1:3001/apod; }
    location /api/marte       { proxy_pass http://127.0.0.1:3002/marte; }
    location /api/asteroides  { proxy_pass http://127.0.0.1:3003/asteroides; }
    location /api/iss         { proxy_pass http://127.0.0.1:3004/iss; }
    location /api/alertas     { proxy_pass http://127.0.0.1:3007/alertas; }
    location /api/auth        { proxy_pass http://127.0.0.1:3005/auth; }
    location /api/reportes    { proxy_pass http://127.0.0.1:3006/reportes; }

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }
}
